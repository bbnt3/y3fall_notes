# ESC384: regenerate lectures.tex from every PDF in lectures/ before each
# build, so dropping a downloaded lecture PDF into lectures/ is all it takes
# to add it to main.pdf.
#
# Each PDF's first page is read with Ghostscript to find "Lecture N" and the
# title below it; PDFs are ordered by N and listed in the table of contents
# as "Lecture N: Title". PDFs without a "Lecture N" line go last (sorted by
# file name) and use the file name as their title.

use strict;
use warnings;

my @gs_candidates = ('gs', '/usr/local/bin/gs', '/opt/homebrew/bin/gs');

sub first_page_text {
    my ($pdf) = @_;
    for my $gs (@gs_candidates) {
        my $text = `"$gs" -q -dNOPAUSE -dBATCH -sDEVICE=txtwrite -dFirstPage=1 -dLastPage=1 -sOutputFile=- "$pdf" 2>/dev/null`;
        return $text if defined $text && $text ne '';
    }
    return '';
}

sub tex_escape {
    my ($s) = @_;
    $s =~ s/\\/\\textbackslash{}/g;
    $s =~ s/([&%\$#_{}])/\\$1/g;
    $s =~ s/~/\\textasciitilde{}/g;
    $s =~ s/\^/\\textasciicircum{}/g;
    return $s;
}

my @entries;
for my $pdf (sort glob('lectures/*.pdf')) {
    my @lines = grep { $_ ne '' } map { s/^\s+|\s+$//gr } split /\n/, first_page_text($pdf);
    my ($num, @title);
    for my $i (0 .. $#lines) {
        next unless $lines[$i] =~ /^Lecture\s+(\d+)\b/;
        $num = $1;
        for my $line (@lines[$i + 1 .. $#lines]) {
            last if $line =~ /^(\x{00A9}|\xC2\xA9|\(c\))/;   # stop at the copyright line
            push @title, $line;
            last if @title == 3;
        }
        last;
    }
    my $name = $pdf =~ s{^lectures/}{}r =~ s/\.pdf$//r;
    my $title = @title ? join(' ', @title) : $name;
    push @entries, {
        pdf   => $pdf,
        num   => $num,
        label => defined $num ? "Lecture $num: " . tex_escape($title) : tex_escape($title),
    };
}

@entries = sort {
    (defined $a->{num} ? 0 : 1) <=> (defined $b->{num} ? 0 : 1)
        || ($a->{num} // 0) <=> ($b->{num} // 0)
        || $a->{pdf} cmp $b->{pdf}
} @entries;

my $out = "% Generated by latexmkrc from lectures/*.pdf -- do not edit by hand.\n";
my $k = 0;
for my $e (@entries) {
    $k++;
    $out .= "\\includepdf[pages=-,addtotoc={1,section,1,{$e->{label}},lecpdf$k}]{$e->{pdf}}\n";
}

# Only rewrite when the list changes, so latexmk doesn't rebuild needlessly.
my $old = '';
if (open my $in, '<', 'lectures.tex') { local $/; $old = <$in>; close $in; }
if ($out ne $old) {
    open my $fh, '>', 'lectures.tex' or die "cannot write lectures.tex: $!";
    print $fh $out;
    close $fh;
}
